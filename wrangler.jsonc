{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maigo-poster",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "maigo-poster.yhay81.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maigo-poster",
      "database_id": "42c925ca-1138-466c-8392-3916598e9c3c",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "maigo-poster-photos",
    },
  ],
  "triggers": {
    "crons": ["47 18 * * *"],
  },
}
